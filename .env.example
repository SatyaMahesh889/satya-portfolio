# Copy to .env (local) or set in Cloudflare Pages → Settings → Environment variables.
# Every value is optional. Anything left empty is simply not shown on the site.

# Public site origin, no trailing slash. Enables canonical URLs, og:url and sitemap.xml.
VITE_SITE_URL=

# Overrides the public email (default: maheshindugula@gmail.com, set in src/data/links.ts).
VITE_CONTACT_EMAIL=

# WhatsApp number in international format, digits only (e.g. 919876543210). Adds a WhatsApp card.
VITE_WHATSAPP_NUMBER=

# Resume PDF: a path under /public (e.g. /resume/satya-mahesh-indugula.pdf) or an absolute URL.
# Replaces "Request via LinkedIn" with a download button.
VITE_RESUME_URL=

# Enquiry form delivery endpoint that accepts a JSON POST {name,email,message} and returns 2xx
# (e.g. https://formspree.io/f/xxxxxxx). When empty, the form is not rendered at all.
VITE_FORM_ENDPOINT=
